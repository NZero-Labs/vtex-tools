# Application
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=

# Neon (`test` locally/CI; `production` only in production hosting)
DATABASE_ENV=test
NEON_BRANCH=test
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/database?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/database?sslmode=verify-full

# First administrator (used only by `bun run admin:create`)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# VTEX integration
VTEX_ACCOUNT=
VTEX_ENVIRONMENT=
VTEX_APP_KEY=
VTEX_APP_TOKEN=
VTEX_BUDGET_ENTITY=BD
VTEX_MONEY_SCALE=100
VTEX_TIMEOUT_MS=10000

# Development and tests only. Ignored when NODE_ENV=production.
USE_VTEX_FIXTURES=false
